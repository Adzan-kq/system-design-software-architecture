# ─────────────────────────────────────────────────────────────────────────────
# Adzan.dev environment variables. Copy to `.env` and fill in real values:
#   cp .env.example .env
# Never commit `.env` (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Neon → your project → Dashboard → "Connect" → choose your branch & database.
# Paste the FULL connection strings from that dialog (don't edit this template by hand).

# Pooled connection ("Connection pooling" ON; hostname contains `-pooler`). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct connection ("Connection pooling" OFF; no `-pooler`). Used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Password for /admin. Use a long random passphrase.
ADMIN_PASSWORD="change-me-to-a-long-random-passphrase"

# Secret used to sign the admin session cookie (min 32 chars).
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="replace-with-output-of-openssl-rand-base64-32"
