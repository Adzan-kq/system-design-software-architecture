---
/**
 * Progressive enhancement for Shiki code blocks: wraps each in a card with a
 * language label and a copy button. Without JS, blocks still render normally.
 */
---

<script>
  const ICON_COPY =
    '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2"/><path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/></svg>';
  const ICON_CHECK =
    '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true"><path d="m5 10 3.5 3.5L15 7"/></svg>';

  document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code').forEach((pre) => {
    const lang = pre.dataset.language ?? '';
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block not-prose';

    const header = document.createElement('div');
    header.className = 'code-block-header';
    header.innerHTML = `<span>${lang === 'plaintext' ? 'text' : lang}</span>`;

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'inline-flex items-center gap-1 rounded-md px-1.5 py-1 transition-colors hover:bg-subtle hover:text-ink';
    btn.setAttribute('aria-label', 'Copy code');
    btn.innerHTML = ICON_COPY;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.innerHTML = `${ICON_CHECK}<span>Copied</span>`;
        btn.classList.add('text-accent');
        setTimeout(() => {
          btn.innerHTML = ICON_COPY;
          btn.classList.remove('text-accent');
        }, 1600);
      } catch {
        btn.setAttribute('aria-label', 'Copy failed');
      }
    });

    header.append(btn);
    pre.replaceWith(wrapper);
    wrapper.append(header, pre);
  });
</script>
