---
import { SITE } from '../config';
import { url } from '../lib/notes';
---

<footer class="mt-16 border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-ink-subtle sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>
      © {new Date().getFullYear()} {SITE.author}. Learning in public, one note at a time.
    </p>
    <nav class="flex gap-5" aria-label="Footer">
      <a href={url('/notes/')} class="transition-colors hover:text-accent">System Design</a>
      <a href={url('/journey/')} class="transition-colors hover:text-accent">Journey</a>
      <a href={SITE.repo} target="_blank" rel="noopener" class="transition-colors hover:text-accent">GitHub ↗</a>
    </nav>
  </div>
</footer>
