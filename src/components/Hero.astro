---
import { SITE } from '../config';
import { url } from '../lib/notes';

interface Props {
  /** Optional "currently working on" line, e.g. the ongoing journey phase. */
  current?: string;
}

const { current } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <!-- Soft warm glow behind the hero -->
  <div
    class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-[28rem] w-[56rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,var(--color-accent-soft),transparent)] opacity-80 blur-2xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl px-4 pt-16 pb-14 sm:px-6 sm:pt-24 sm:pb-20">
    {
      current && (
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1 text-sm text-ink-muted shadow-sm">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60" />
            <span class="relative inline-flex size-2 rounded-full bg-accent" />
          </span>
          Currently: <span class="font-medium text-ink">{current}</span>
        </p>
      )
    }

    <h1 class="max-w-3xl text-4xl leading-[1.1] font-extrabold text-ink sm:text-6xl">
      Hi, I'm {SITE.author} <span class="inline-block origin-[70%_70%] motion-safe:animate-[wave_2.4s_ease-in-out_1]" aria-hidden="true">👋</span>
      <span class="mt-3 block text-2xl leading-snug font-bold text-ink-muted sm:text-3xl">
        Software Developer &amp; <span class="text-accent">Lifelong Learner</span>
      </span>
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">
      This is my digital garden, where I document my journey into software architecture and how
      scalable systems are built. Some notes are polished, others are still growing, and all of
      them are written to help me (and maybe you) understand things deeply.
    </p>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a
        href={url('/notes/')}
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-5 py-3 font-medium text-accent-contrast shadow-sm shadow-accent/20 transition hover:bg-accent-hover hover:shadow-md motion-safe:hover:-translate-y-0.5"
      >
        Explore System Design Notes
        <span aria-hidden="true">→</span>
      </a>
      <a
        href={url('/journey/')}
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-line bg-card px-5 py-3 font-medium text-ink transition hover:border-accent/40 hover:text-accent"
      >
        My Developer Journey
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10%, 30% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }
</style>
