---
/**
 * Vertical timeline grouped by year. Each entry can be expanded to read the
 * full story (Markdown body) and shows links to the technical notes written
 * during that phase.
 *
 * `compact` renders a short, non-expandable version for the home page.
 */
import { getEntries, render } from 'astro:content';
import { JOURNEY_TYPE_META, formatRange, groupByYear, type JourneyEntry } from '../lib/journey';
import { noteHref, url } from '../lib/notes';

interface Props {
  entries: JourneyEntry[];
  compact?: boolean;
}

const { entries, compact = false } = Astro.props;

const items = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: compact ? null : (await render(entry)).Content,
    hasBody: !!entry.body?.trim(),
    notes: compact ? [] : await getEntries(entry.data.relatedNotes),
  })),
);
const byId = new Map(items.map((i) => [i.entry.id, i]));
const years = groupByYear(entries);
---

<div class="space-y-10">
  {
    years.map(([year, yearEntries]) => (
      <section aria-labelledby={`year-${year}`} data-year-group>
        <h2
          id={`year-${year}`}
          class="sticky top-14 z-10 -mx-1 mb-4 bg-white/90 px-1 py-2 font-mono text-sm font-semibold text-zinc-500 backdrop-blur dark:bg-zinc-950/90"
        >
          {year}
        </h2>

        <ol class="relative ml-2 border-l border-zinc-200 dark:border-zinc-800">
          {yearEntries.map((e) => {
            const { Content, hasBody, notes } = byId.get(e.id)!;
            const meta = JOURNEY_TYPE_META[e.data.type];
            return (
              <li id={`j-${e.id}`} class="relative scroll-mt-28 pb-8 pl-8 last:pb-0" data-type={e.data.type}>
                <span
                  class:list={[
                    'absolute top-1.5 -left-[7px] size-3.5 rounded-full ring-4',
                    meta.dot,
                    e.data.current && 'animate-pulse',
                  ]}
                  aria-hidden="true"
                />

                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <time class="font-mono text-xs text-zinc-500">{formatRange(e.data)}</time>
                  <span class:list={['rounded px-1.5 py-0.5 text-[11px] font-medium', meta.badge]}>
                    {meta.label}
                  </span>
                  {e.data.current && (
                    <span class="text-[11px] font-medium text-emerald-600 dark:text-emerald-400">● Now</span>
                  )}
                </div>

                <h3 class="mt-1.5 font-semibold text-zinc-900 dark:text-zinc-100">{e.data.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{e.data.summary}</p>

                {!compact && e.data.skills.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Skills">
                    {e.data.skills.map((s) => (
                      <li class="rounded-md border border-zinc-200 px-2 py-0.5 font-mono text-[11px] text-zinc-600 dark:border-zinc-800 dark:text-zinc-400">
                        {s}
                      </li>
                    ))}
                  </ul>
                )}

                {!compact && notes.length > 0 && (
                  <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
                    <span class="text-xs text-zinc-500">Notes from this phase:</span>
                    {notes.map((n) => (
                      <a
                        href={noteHref(n)}
                        class="rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-700 hover:bg-indigo-50 hover:text-indigo-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-indigo-500/10 dark:hover:text-indigo-300"
                      >
                        {n.data.title} →
                      </a>
                    ))}
                  </div>
                )}

                {!compact && (hasBody || e.data.link) && (
                  <details class="group mt-3">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1 text-sm font-medium text-indigo-600 select-none dark:text-indigo-400 [&::-webkit-details-marker]:hidden">
                      <span class="group-open:hidden">Read the story</span>
                      <span class="hidden group-open:inline">Hide</span>
                      <svg class="size-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z" />
                      </svg>
                    </summary>
                    <div class="prose prose-sm prose-zinc mt-3 max-w-none dark:prose-invert prose-a:text-indigo-600 dark:prose-a:text-indigo-400">
                      {Content && <Content />}
                      {e.data.link && (
                        <p>
                          <a href={e.data.link.href} target="_blank" rel="noopener">
                            {e.data.link.label} ↗
                          </a>
                        </p>
                      )}
                    </div>
                  </details>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }
  {
    compact && (
      <a href={url('/journey/')} class="inline-block text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400">
        See the full journey →
      </a>
    )
  }
</div>
