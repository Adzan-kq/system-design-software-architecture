---
/**
 * Client-side Mermaid renderer. Shiki skips ```mermaid blocks (see
 * `excludeLangs` in astro.config.mjs), so they arrive as
 * <pre><code class="language-mermaid">. This script swaps each one for a
 * rendered SVG in a bordered container, themed to match the site, and
 * re-renders when the theme changes. The mermaid bundle is only downloaded
 * on pages that contain a diagram.
 */
---

<script>
  const blocks = document.querySelectorAll<HTMLElement>('pre:has(> code.language-mermaid)');

  // Palette mirrors the design tokens in global.css.
  const THEMES = {
    light: {
      background: '#ffffff',
      primaryColor: '#f0fdfa', // teal-50
      primaryBorderColor: '#0d9488', // teal-600
      primaryTextColor: '#1c1917', // stone-900
      secondaryColor: '#f5f5f4', // stone-100
      tertiaryColor: '#fafaf9',
      lineColor: '#78716c', // stone-500
      textColor: '#44403c', // stone-700
      noteBkgColor: '#fef3c7',
      noteBorderColor: '#d97706',
      edgeLabelBackground: '#ffffff',
    },
    dark: {
      background: '#1e293b',
      primaryColor: '#134e4a', // teal-900
      primaryBorderColor: '#2dd4bf', // teal-400
      primaryTextColor: '#f8fafc',
      secondaryColor: '#334155', // slate-700
      tertiaryColor: '#1e293b',
      lineColor: '#94a3b8', // slate-400
      textColor: '#cbd5e1', // slate-300
      noteBkgColor: '#422006',
      noteBorderColor: '#f59e0b',
      edgeLabelBackground: '#1e293b',
    },
  };

  if (blocks.length) {
    const diagrams = [...blocks].map((pre) => {
      const figure = document.createElement('figure');
      figure.className = 'mermaid-diagram not-prose';
      figure.setAttribute('role', 'img');
      figure.dataset.source = pre.textContent ?? '';
      figure.textContent = figure.dataset.source;
      pre.replaceWith(figure);
      return figure;
    });

    const { default: mermaid } = await import('mermaid');
    let renderCount = 0;

    const render = async () => {
      const dark = document.documentElement.classList.contains('dark');
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        securityLevel: 'strict',
        fontFamily: 'Inter, ui-sans-serif, system-ui, sans-serif',
        themeVariables: { ...(dark ? THEMES.dark : THEMES.light), fontSize: '15px' },
        flowchart: { curve: 'basis', padding: 16 },
      });
      for (const el of diagrams) {
        try {
          const { svg } = await mermaid.render(`mermaid-${renderCount++}`, el.dataset.source!);
          el.innerHTML = svg;
          el.dataset.rendered = '';
        } catch (err) {
          el.textContent = `Mermaid error: ${(err as Error).message}\n\n${el.dataset.source}`;
        }
      }
    };

    await render();
    document.addEventListener('themechange', render);
  }
</script>
