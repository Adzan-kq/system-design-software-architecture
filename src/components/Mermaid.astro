---
/**
 * Client-side Mermaid renderer. Shiki skips ```mermaid blocks (see
 * `excludeLangs` in astro.config.mjs), so they arrive as
 * <pre><code class="language-mermaid">. This script swaps each one for a
 * rendered SVG and re-renders when the theme changes.
 * The mermaid bundle is only downloaded on pages that contain a diagram.
 */
---

<script>
  const blocks = document.querySelectorAll<HTMLElement>('pre:has(> code.language-mermaid)');

  if (blocks.length) {
    // Replace each <pre> with a container that remembers the source.
    const diagrams = [...blocks].map((pre) => {
      const el = document.createElement('div');
      el.className = 'mermaid-diagram not-prose';
      el.dataset.source = pre.textContent ?? '';
      el.textContent = el.dataset.source;
      pre.replaceWith(el);
      return el;
    });

    const { default: mermaid } = await import('mermaid');
    let renderCount = 0;

    const render = async () => {
      const dark = document.documentElement.classList.contains('dark');
      mermaid.initialize({
        startOnLoad: false,
        theme: dark ? 'dark' : 'neutral',
        securityLevel: 'strict',
        fontFamily: 'Inter, ui-sans-serif, system-ui, sans-serif',
      });
      for (const el of diagrams) {
        try {
          const { svg } = await mermaid.render(`mermaid-${renderCount++}`, el.dataset.source!);
          el.innerHTML = svg;
          el.dataset.rendered = '';
        } catch (err) {
          el.textContent = `Mermaid error: ${(err as Error).message}\n\n${el.dataset.source}`;
        }
      }
    };

    await render();
    document.addEventListener('themechange', render);
  }
</script>
