---
/**
 * Sticky glassmorphism navbar: brand · links · GitHub · theme toggle.
 */
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../config';
import { url } from '../lib/notes';

const path = Astro.url.pathname;
const isActive = (...prefixes: string[]) => prefixes.some((p) => path.startsWith(url(p)));

const links = [
  // Hidden below `sm` (the brand already links home) to keep the bar within 360px.
  { label: 'Home', short: 'Home', href: url('/'), active: path === url('/') || path === url('/').slice(0, -1), desktopOnly: true },
  { label: 'System Design', short: 'Notes', href: url('/notes/'), active: isActive('/notes', '/roadmap') },
  { label: 'Journey', short: 'Journey', href: url('/journey/'), active: isActive('/journey') },
];
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-canvas/70 backdrop-blur-xl backdrop-saturate-150">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-4 sm:px-6">
    <a href={url('/')} class="group flex items-center gap-2 rounded-lg font-display text-lg font-extrabold tracking-tight">
      <span
        class="grid size-8 place-items-center rounded-xl bg-accent text-sm text-accent-contrast shadow-sm transition-transform group-hover:-rotate-6"
        aria-hidden="true">A</span
      >
      <span>Adzan<span class="text-accent">.dev</span></span>
    </a>

    <nav class="ml-auto flex items-center gap-0.5 sm:gap-1" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={l.active ? 'page' : undefined}
            class:list={[
              'rounded-lg px-2.5 py-1.5 text-sm font-medium transition-colors sm:px-3',
              l.desktopOnly && 'hidden sm:block',
              l.active
                ? 'bg-accent-soft text-accent'
                : 'text-ink-muted hover:bg-subtle hover:text-ink',
            ]}
          >
            <span class="sm:hidden">{l.short}</span>
            <span class="hidden sm:inline">{l.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-0.5 border-l border-line pl-2 sm:ml-1 sm:pl-3">
      <a
        href={SITE.repo}
        target="_blank"
        rel="noopener"
        aria-label="GitHub repository"
        class="hidden rounded-lg p-2 text-ink-muted transition-colors hover:bg-subtle hover:text-ink min-[400px]:block"
      >
        <svg viewBox="0 0 16 16" class="size-5" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
