---
import StatusBadge from './StatusBadge.astro';
import { noteHref, readingTime, topicOf, topicTitle, type Note } from '../lib/notes';

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { title, description, status, tags, updated } = note.data;
const minutes = readingTime(note);
---

<article
  data-reveal
  data-topic={topicOf(note)}
  class="group relative flex flex-col rounded-2xl border border-line bg-card p-6 shadow-sm shadow-stone-900/[0.02] transition duration-300 hover:border-accent/40 hover:shadow-lg hover:shadow-stone-900/5 motion-safe:hover:-translate-y-1 dark:shadow-none"
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-ink-subtle">
    <StatusBadge status={status} size="sm" />
    <span>{topicTitle(note)}</span>
    <span aria-hidden="true">·</span>
    <span>{minutes} min read</span>
  </div>

  <h3 class="mt-4 text-lg font-bold text-ink transition-colors group-hover:text-accent">
    <!-- Stretched link: the whole card is clickable, but stays one focusable element. -->
    <a href={noteHref(note)} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none">
      {title}
    </a>
  </h3>
  {description && <p class="mt-2 line-clamp-3 text-[0.95rem] leading-relaxed text-ink-muted">{description}</p>}

  <div class="mt-auto flex items-end justify-between gap-4 pt-5">
    <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
      {
        tags.slice(0, 3).map((t) => (
          <li class="rounded-md bg-subtle px-2 py-0.5 font-mono text-[11px] text-ink-muted">#{t}</li>
        ))
      }
    </ul>
    {
      updated && (
        <time class="shrink-0 font-mono text-[11px] text-ink-subtle" datetime={updated.toISOString()}>
          {updated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}
        </time>
      )
    }
  </div>
</article>

<style>
  /* Keyboard focus ring for the stretched-link card. */
  article:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
