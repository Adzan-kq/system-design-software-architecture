---
import NoteCard from './NoteCard.astro';
import { SITE } from '../config';
import type { Note } from '../lib/notes';

interface Props {
  notes: Note[];
  id?: string;
}

const { notes, id } = Astro.props;
---

{
  notes.length > 0 ? (
    <div id={id} class="grid gap-5 md:grid-cols-2">
      {notes.map((note) => <NoteCard note={note} />)}
    </div>
  ) : (
    <div class="rounded-2xl border border-dashed border-line bg-card/50 px-6 py-14 text-center">
      <p class="text-3xl" aria-hidden="true">🌱</p>
      <p class="mt-3 font-display text-lg font-bold text-ink">The garden is freshly planted</p>
      <p class="mx-auto mt-2 max-w-md text-ink-muted">
        No notes published yet. The first ones are growing. Check back soon, or follow along on{' '}
        <a href={SITE.repo} target="_blank" rel="noopener" class="font-medium text-accent hover:underline">GitHub</a>.
      </p>
    </div>
  )
}
