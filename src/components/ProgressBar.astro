---
interface Props {
  value: number;
  label?: string;
  class?: string;
}

const { value, label = 'Progress', class: className } = Astro.props;
const pct = Math.max(0, Math.min(100, value));
---

<div
  class:list={['h-1.5 w-full overflow-hidden rounded-full bg-subtle', className]}
  role="progressbar"
  aria-label={label}
  aria-valuenow={pct}
  aria-valuemin="0"
  aria-valuemax="100"
>
  <div
    class:list={[
      'h-full rounded-full transition-[width] duration-700',
      pct === 100 ? 'bg-emerald-500 dark:bg-emerald-400' : 'bg-accent',
    ]}
    style={`width: ${pct}%`}
  >
  </div>
</div>
