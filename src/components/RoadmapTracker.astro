---
/**
 * Visual roadmap: topics as a numbered vertical timeline with per-topic progress.
 */
import ProgressBar from './ProgressBar.astro';
import StatusBadge from './StatusBadge.astro';
import { noteHref, url, type TopicGroup } from '../lib/notes';

interface Props {
  groups: TopicGroup[];
}

const { groups } = Astro.props;

const dot = {
  completed: 'bg-emerald-500 text-white border-emerald-500',
  'in-progress': 'bg-white text-amber-600 border-amber-500 dark:bg-zinc-950',
  planned: 'bg-white text-zinc-400 border-zinc-300 dark:bg-zinc-950 dark:border-zinc-700',
};
---

<ol class="relative space-y-4">
  {
    groups.map((g, i) => (
      <li class="relative flex gap-4">
        {i < groups.length - 1 && (
          <span
            class="absolute top-9 left-[15px] h-[calc(100%-1.25rem)] w-px bg-zinc-200 dark:bg-zinc-800"
            aria-hidden="true"
          />
        )}
        <span
          class:list={[
            'z-10 grid size-8 shrink-0 place-items-center rounded-full border-2 font-mono text-xs font-semibold',
            dot[g.status],
          ]}
        >
          {g.status === 'completed' ? '✓' : i + 1}
        </span>

        <a
          href={g.notes[0] ? noteHref(g.notes[0]) : url(`/roadmap/#${g.slug}`)}
          class="group flex-1 rounded-xl border border-zinc-200 p-4 transition hover:border-indigo-300 hover:shadow-sm dark:border-zinc-800 dark:hover:border-indigo-500/50"
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="font-semibold group-hover:text-indigo-600 dark:group-hover:text-indigo-400">
              {g.title}
            </h3>
            <StatusBadge status={g.status} size="sm" />
          </div>
          {g.description && (
            <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{g.description}</p>
          )}
          <div class="mt-3 flex items-center gap-3">
            <ProgressBar value={g.progress} label={`${g.title} progress`} />
            <span class="shrink-0 font-mono text-xs text-zinc-500">
              {g.completed}/{g.notes.length}
            </span>
          </div>
        </a>
      </li>
    ))
  }
</ol>
