---
import { getTopicGroups, noteHref } from '../lib/notes';

interface Props {
  currentId?: string;
}

const { currentId } = Astro.props;
const groups = (await getTopicGroups()).filter((g) => g.notes.length > 0);

const dot = {
  completed: 'bg-emerald-500',
  'in-progress': 'bg-amber-500',
  planned: 'bg-zinc-300 dark:bg-zinc-600',
};
---

<nav aria-label="Notes" class="space-y-5 text-sm">
  {
    groups.map((g) => (
      <details open class="group/topic">
        <summary class="flex cursor-pointer list-none items-center justify-between py-1 font-semibold text-zinc-900 dark:text-zinc-100 [&::-webkit-details-marker]:hidden">
          {g.title}
          <svg
            class="size-4 text-zinc-400 transition-transform group-open/topic:rotate-90"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M7.3 14.7a1 1 0 0 1 0-1.4L10.6 10 7.3 6.7a1 1 0 0 1 1.4-1.4l4 4a1 1 0 0 1 0 1.4l-4 4a1 1 0 0 1-1.4 0Z" />
          </svg>
        </summary>
        <ul class="mt-1 space-y-0.5 border-l border-zinc-200 dark:border-zinc-800">
          {g.notes.map((n) => {
            const active = n.id === currentId;
            return (
              <li>
                <a
                  href={noteHref(n)}
                  aria-current={active ? 'page' : undefined}
                  title={n.data.status}
                  class:list={[
                    '-ml-px flex items-center gap-2 border-l py-1.5 pr-2 pl-4 transition-colors',
                    active
                      ? 'border-indigo-500 font-medium text-indigo-600 dark:text-indigo-400'
                      : 'border-transparent text-zinc-600 hover:border-zinc-400 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white',
                  ]}
                >
                  <span class:list={['size-1.5 shrink-0 rounded-full', dot[n.data.status]]} aria-hidden="true" />
                  <span class="truncate">{n.data.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    ))
  }
</nav>
