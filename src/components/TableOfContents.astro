---
/** Floating "On this page" card with scroll-spy highlighting. */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const headings = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  headings.length > 0 && (
    <nav aria-label="On this page" class="rounded-2xl border border-line bg-card/70 p-5 text-sm shadow-sm backdrop-blur">
      <p class="mb-3 font-mono text-[11px] font-semibold tracking-wider text-ink-subtle uppercase">On this page</p>
      <ul class="space-y-1 border-l border-line" id="toc">
        {headings.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-slug={h.slug}
              class:list={[
                '-ml-px block border-l-2 border-transparent py-1 leading-snug text-ink-muted transition-colors hover:text-ink data-[active]:border-accent data-[active]:font-medium data-[active]:text-accent',
                h.depth === 3 ? 'pl-6 text-[13px]' : 'pl-3',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
      <button
        type="button"
        id="back-to-top"
        class="mt-4 text-xs font-medium text-ink-subtle transition-colors hover:text-accent"
      >
        ↑ Back to top
      </button>
    </nav>
  )
}

<script>
  document.getElementById('back-to-top')?.addEventListener('click', () =>
    window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }),
  );

  // Highlight the TOC entry for the section currently in view.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#toc a[data-slug]')];
  const targets = links
    .map((a) => document.getElementById(a.dataset.slug!))
    .filter((el): el is HTMLElement => !!el);

  if (targets.length) {
    const setActive = (id: string) => links.forEach((a) => a.toggleAttribute('data-active', a.dataset.slug === id));
    // Active = the last heading that has scrolled above the reading line.
    // Position-based (not IntersectionObserver) so fast scrolls/jumps never leave it stale.
    let ticking = false;
    const update = () => {
      ticking = false;
      const line = 120;
      let current = targets[0];
      for (const t of targets) {
        if (t.getBoundingClientRect().top <= line) current = t;
        else break;
      }
      // At the very bottom, highlight the last section even if its heading is low.
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) current = targets[targets.length - 1];
      setActive(current.id);
    };
    addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
</script>
