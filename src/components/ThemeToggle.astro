<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  class="group relative grid size-9 place-items-center overflow-hidden rounded-lg text-ink-muted transition-colors hover:bg-subtle hover:text-ink"
>
  <!-- Sun: visible in dark mode -->
  <svg
    class="absolute size-5 scale-50 rotate-90 opacity-0 transition-all duration-500 dark:scale-100 dark:rotate-0 dark:opacity-100"
    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"></path>
  </svg>
  <!-- Moon: visible in light mode -->
  <svg
    class="absolute size-5 transition-all duration-500 dark:scale-50 dark:-rotate-90 dark:opacity-0"
    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) root.classList.add('theme-transition');

    const dark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
    // Lets other components (e.g. Mermaid) re-theme themselves.
    document.dispatchEvent(new CustomEvent('themechange', { detail: { dark } }));

    if (!reduce) setTimeout(() => root.classList.remove('theme-transition'), 350);
  });
</script>
