---
/**
 * Three-column docs layout: sidebar · article · table of contents.
 * Collapses to a single column with a toggleable sidebar on small screens.
 */
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Mermaid from '../components/Mermaid.astro';

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  currentId?: string;
}

const { title, description, headings = [], currentId } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto flex max-w-7xl px-4 sm:px-6">
    <!-- Sidebar -->
    <aside
      id="sidebar"
      class="fixed inset-x-0 top-14 bottom-0 z-30 hidden overflow-y-auto border-r border-zinc-200 bg-white px-6 py-6 lg:sticky lg:block lg:h-[calc(100dvh-3.5rem)] lg:w-64 lg:shrink-0 lg:bg-transparent lg:px-0 lg:pr-6 dark:border-zinc-800 dark:bg-zinc-950 lg:dark:bg-transparent"
    >
      <Sidebar currentId={currentId} />
    </aside>

    <!-- Main -->
    <main class="min-w-0 flex-1 py-8 lg:px-10">
      <button
        id="sidebar-toggle"
        type="button"
        aria-controls="sidebar"
        aria-expanded="false"
        class="mb-6 inline-flex items-center gap-2 rounded-md border border-zinc-200 px-3 py-1.5 text-sm text-zinc-600 lg:hidden dark:border-zinc-800 dark:text-zinc-400"
      >
        <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M3 5h14v2H3zm0 4h14v2H3zm0 4h14v2H3z"></path>
        </svg>
        Menu
      </button>
      <slot />
    </main>

    <!-- TOC -->
    <aside class="hidden w-56 shrink-0 xl:block">
      <div class="sticky top-14 max-h-[calc(100dvh-3.5rem)] overflow-y-auto py-8">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
  <Mermaid />
</BaseLayout>

<script>
  const btn = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('sidebar');
  btn?.addEventListener('click', () => {
    const open = sidebar!.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('overflow-hidden', open);
  });
</script>
