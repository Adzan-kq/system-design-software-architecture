---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/notes';
---

<BaseLayout title="Not found">
  <main class="mx-auto max-w-xl px-4 py-32 text-center">
    <p class="font-mono text-sm text-indigo-600 dark:text-indigo-400">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">This note hasn't grown yet.</h1>
    <p class="mt-3 text-zinc-500">The page you're looking for doesn't exist (or is still a seed).</p>
    <a href={url('/')} class="mt-8 inline-block rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-indigo-500">
      Back home
    </a>
  </main>
</BaseLayout>
