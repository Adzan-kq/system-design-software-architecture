---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/notes';
---

<BaseLayout title="Not found">
  <main class="mx-auto max-w-xl px-4 py-32 text-center">
    <p class="font-mono text-sm font-medium text-accent">404</p>
    <h1 class="mt-3 text-4xl font-extrabold text-ink">This note hasn't sprouted yet 🌱</h1>
    <p class="mt-4 text-ink-muted">The page you're looking for doesn't exist, or it's still a seed in my garden.</p>
    <div class="mt-9 flex justify-center gap-3">
      <a href={url('/')} class="rounded-xl bg-accent px-5 py-3 font-medium text-accent-contrast transition hover:bg-accent-hover">
        Back home
      </a>
      <a href={url('/notes/')} class="rounded-xl border border-line bg-card px-5 py-3 font-medium text-ink transition hover:text-accent">
        Browse notes
      </a>
    </div>
  </main>
</BaseLayout>
