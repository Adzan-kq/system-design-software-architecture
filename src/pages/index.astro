---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TopicProgressStrip from '../components/TopicProgressStrip.astro';
import NotesGrid from '../components/NotesGrid.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import { getNotes, getTopicGroups, overallProgress, url } from '../lib/notes';
import { getJourney } from '../lib/journey';

const groups = await getTopicGroups();
const pillars = groups.filter((g) => g.notes.length > 0);
const stats = overallProgress(groups);

// Most recently tended notes first; planned stubs only fill remaining slots.
const latestNotes = (await getNotes())
  .sort(
    (a, b) =>
      Number(a.data.status === 'planned') - Number(b.data.status === 'planned') ||
      (b.data.updated?.valueOf() ?? 0) - (a.data.updated?.valueOf() ?? 0),
  )
  .slice(0, 4);

const journey = await getJourney();
const featured = journey.filter((e) => e.data.featured);
const journeyPreview = (featured.length ? featured : journey).slice(0, 3);
const current = journey.find((e) => e.data.current);
---

<BaseLayout>
  <Hero current={current?.data.title} />

  <main class="mx-auto max-w-6xl space-y-24 px-4 sm:px-6">
    <section>
      <SectionHeading
        eyebrow="Learning progress"
        title="Core pillars"
        description={`${stats.completed} of ${stats.total} notes completed so far. In-progress notes count as half done.`}
        link={{ href: url('/roadmap/'), label: 'Full roadmap' }}
      />
      <TopicProgressStrip groups={pillars} />
    </section>

    <section>
      <SectionHeading
        eyebrow="Digital garden"
        title="Recently tended notes"
        description="Notes grow over time, from rough seedlings to polished write-ups."
        link={{ href: url('/notes/'), label: 'All notes' }}
      />
      <NotesGrid notes={latestNotes} />
    </section>

    <section>
      <SectionHeading
        eyebrow="Developer journey"
        title="How I got here"
        description="Milestones and lessons from growing as a software developer."
        link={{ href: url('/journey/'), label: 'Full timeline' }}
      />
      <div class="max-w-3xl">
        <JourneyTimeline entries={journeyPreview} compact />
      </div>
    </section>
  </main>
</BaseLayout>
