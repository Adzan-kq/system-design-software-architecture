---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoadmapTracker from '../components/RoadmapTracker.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import ProgressBar from '../components/ProgressBar.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { SITE } from '../config';
import { getNotes, getTopicGroups, noteHref, overallProgress, url } from '../lib/notes';
import { getJourney } from '../lib/journey';

const groups = await getTopicGroups();
const stats = overallProgress(groups);
const firstNote = groups.find((g) => g.notes.length)?.notes[0];

const journey = await getJourney();
const featured = journey.filter((e) => e.data.featured);
const journeyPreview = (featured.length ? featured : journey).slice(0, 3);
const current = journey.find((e) => e.data.current);

const recentNotes = (await getNotes())
  .filter((n) => n.data.updated)
  .sort((a, b) => b.data.updated!.valueOf() - a.data.updated!.valueOf())
  .slice(0, 4);

const doors = [
  {
    href: url('/journey/'),
    kicker: 'Personal',
    title: 'Developer Journey',
    body: 'Milestones, learning phases, and projects: how I grew as a developer.',
    meta: `${journey.length} milestones`,
  },
  {
    href: firstNote ? noteHref(firstNote) : url('/roadmap/'),
    kicker: 'Technical',
    title: 'Knowledge Base',
    body: 'Study notes and case studies on System Design & Software Architecture.',
    meta: `${stats.total} notes · ${stats.progress}% complete`,
  },
];
---

<BaseLayout>
  <main class="mx-auto max-w-5xl px-4 sm:px-6">
    <!-- Hero -->
    <section class="pt-16 pb-12 sm:pt-24">
      <p class="font-mono text-sm text-indigo-600 dark:text-indigo-400">~/{SITE.author.toLowerCase()}</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-white">
        Hi, I'm {SITE.author}.<br class="hidden sm:block" /> I build software and keep learning in public.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
        This is my digital garden: a record of how I'm growing as a software developer, and the
        notes I take along the way on distributed systems and software architecture.
      </p>
      {
        current && (
          <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-zinc-200 px-3 py-1 text-sm dark:border-zinc-800">
            <span class="size-2 animate-pulse rounded-full bg-emerald-500" aria-hidden="true" />
            <span class="text-zinc-500">Currently:</span>
            <span class="font-medium">{current.data.title}</span>
          </p>
        )
      }
    </section>

    <!-- Two worlds, one site -->
    <section class="grid gap-4 sm:grid-cols-2" aria-label="Sections">
      {
        doors.map((d) => (
          <a
            href={d.href}
            class="group rounded-xl border border-zinc-200 p-6 transition hover:border-indigo-300 hover:shadow-sm dark:border-zinc-800 dark:hover:border-indigo-500/50"
          >
            <p class="font-mono text-xs tracking-wide text-zinc-500 uppercase">{d.kicker}</p>
            <h2 class="mt-2 text-xl font-semibold group-hover:text-indigo-600 dark:group-hover:text-indigo-400">
              {d.title} <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
            </h2>
            <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{d.body}</p>
            <p class="mt-4 font-mono text-xs text-zinc-500">{d.meta}</p>
          </a>
        ))
      }
    </section>

    <!-- Journey preview -->
    {
      journeyPreview.length > 0 && (
        <section class="py-14">
          <h2 class="text-2xl font-bold tracking-tight">Recent milestones</h2>
          <p class="mt-1 mb-6 text-zinc-500 dark:text-zinc-400">Highlights from my developer journey.</p>
          <JourneyTimeline entries={journeyPreview} compact />
        </section>
      )
    }

    <!-- Learning progress -->
    <section class="border-t border-zinc-200 py-14 dark:border-zinc-800">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold tracking-tight">Learning roadmap</h2>
          <p class="mt-1 text-zinc-500 dark:text-zinc-400">
            {stats.completed} of {stats.total} notes completed. In-progress notes count as half done.
          </p>
        </div>
        <div class="flex w-full items-center gap-3 sm:w-64">
          <ProgressBar value={stats.progress} label="Overall progress" class="h-3" />
          <span class="font-mono text-lg font-semibold">{stats.progress}%</span>
        </div>
      </div>

      <div class="mt-8 grid gap-12 lg:grid-cols-[1fr_16rem]">
        <RoadmapTracker groups={groups} />
        <aside>
          <h3 class="text-sm font-semibold tracking-wide text-zinc-500 uppercase">Recently updated notes</h3>
          <ul class="mt-4 space-y-4">
            {
              recentNotes.map((n) => (
                <li>
                  <a href={noteHref(n)} class="group block">
                    <p class="font-medium group-hover:text-indigo-600 dark:group-hover:text-indigo-400">
                      {n.data.title}
                    </p>
                    <div class="mt-1 flex items-center gap-2">
                      <StatusBadge status={n.data.status} size="sm" />
                      <time class="text-xs text-zinc-500" datetime={n.data.updated!.toISOString()}>
                        {n.data.updated!.toLocaleDateString('en-US', { dateStyle: 'medium' })}
                      </time>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>
