---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import { JOURNEY_TYPES } from '../data/journeyTypes';
import { JOURNEY_TYPE_META, getJourney } from '../lib/journey';
import { SITE } from '../config';

const entries = await getJourney();
const usedTypes = JOURNEY_TYPES.filter((t) => entries.some((e) => e.data.type === t));
const allSkills = [...new Set(entries.flatMap((e) => e.data.skills))];
const first = entries.length ? new Date(Math.min(...entries.map((e) => e.data.date.valueOf()))) : undefined;

const stats = [
  { label: 'Milestones', value: entries.length },
  { label: 'Skills picked up', value: allSkills.length },
  ...(first ? [{ label: 'Learning since', value: first.getUTCFullYear() }] : []),
];
---

<BaseLayout title="Journey" description={`${SITE.author}'s growth as a software developer and lifelong learner.`}>
  <main class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
    <SectionHeading
      as="h1"
      eyebrow="git log --reverse"
      title="Developer Journey"
      description="The milestones, learning phases, and projects that shaped how I build software, with short reflections on what each one taught me."
    />

    <dl class="mb-10 grid grid-cols-3 gap-3 sm:max-w-lg">
      {
        stats.map((s) => (
          <div class="rounded-2xl border border-line bg-card px-4 py-3">
            <dt class="text-xs text-ink-subtle">{s.label}</dt>
            <dd class="mt-0.5 font-display text-2xl font-bold text-ink">{s.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mb-12 flex flex-wrap gap-2" role="group" aria-label="Filter by type">
      <button type="button" data-filter="all" aria-pressed="true" class="chip">All</button>
      {
        usedTypes.map((t) => (
          <button type="button" data-filter={t} aria-pressed="false" class="chip">
            <span class:list={['size-2 rounded-full', JOURNEY_TYPE_META[t].dot]} aria-hidden="true" />
            {JOURNEY_TYPE_META[t].label}
          </button>
        ))
      }
    </div>

    {
      entries.length ? (
        <JourneyTimeline entries={entries} />
      ) : (
        <p class="text-ink-subtle italic">No journey entries yet. Add one in the journey/ folder.</p>
      )
    }
  </main>
</BaseLayout>

<style>
  @reference "../styles/global.css";
  .chip {
    @apply inline-flex items-center gap-1.5 rounded-full border border-line bg-card px-3.5 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:text-ink;
  }
  .chip[aria-pressed='true'] {
    @apply border-accent/40 bg-accent-soft text-accent;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('li[data-type]');
  const years = document.querySelectorAll<HTMLElement>('[data-year-group]');

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((li) => (li.hidden = f !== 'all' && li.dataset.type !== f));
      // Hide years that have no visible entries left.
      years.forEach((y) => (y.hidden = !y.querySelector('li[data-type]:not([hidden])')));
    }),
  );
</script>
