---
import BaseLayout from '../layouts/BaseLayout.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import { JOURNEY_TYPES } from '../data/journeyTypes';
import { JOURNEY_TYPE_META, getJourney } from '../lib/journey';
import { SITE } from '../config';

const entries = await getJourney();
const usedTypes = JOURNEY_TYPES.filter((t) => entries.some((e) => e.data.type === t));
const allSkills = [...new Set(entries.flatMap((e) => e.data.skills))];
const first = entries.length
  ? new Date(Math.min(...entries.map((e) => e.data.date.valueOf())))
  : undefined;
---

<BaseLayout title="Journey" description={`${SITE.author}'s growth as a software developer and continuous learner.`}>
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header>
      <p class="font-mono text-sm text-indigo-600 dark:text-indigo-400">git log --reverse</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight">Developer Journey</h1>
      <p class="mt-3 text-zinc-600 dark:text-zinc-400">
        The milestones, learning phases, and projects that shaped how I build software. Technical
        notes from each phase are linked so you can see what I was learning along the way.
      </p>

      <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <div>
          <dt class="text-xs text-zinc-500">Milestones</dt>
          <dd class="font-mono text-xl font-semibold">{entries.length}</dd>
        </div>
        <div>
          <dt class="text-xs text-zinc-500">Skills picked up</dt>
          <dd class="font-mono text-xl font-semibold">{allSkills.length}</dd>
        </div>
        {
          first && (
            <div>
              <dt class="text-xs text-zinc-500">Learning since</dt>
              <dd class="font-mono text-xl font-semibold">{first.getUTCFullYear()}</dd>
            </div>
          )
        }
      </dl>
    </header>

    <!-- Type filter -->
    <div class="mt-8 mb-10 flex flex-wrap gap-2" role="group" aria-label="Filter by type">
      <button type="button" data-filter="all" aria-pressed="true" class="filter-chip">All</button>
      {
        usedTypes.map((t) => (
          <button type="button" data-filter={t} aria-pressed="false" class="filter-chip">
            <span class:list={['size-2 rounded-full', JOURNEY_TYPE_META[t].dot]} aria-hidden="true" />
            {JOURNEY_TYPE_META[t].label}
          </button>
        ))
      }
    </div>

    {
      entries.length ? (
        <JourneyTimeline entries={entries} />
      ) : (
        <p class="text-zinc-500 italic">No journey entries yet. Add one in the journey/ folder.</p>
      )
    }
  </main>
</BaseLayout>

<style>
  @reference "../styles/global.css";
  .filter-chip {
    @apply inline-flex items-center gap-1.5 rounded-full border border-zinc-200 px-3 py-1 text-sm text-zinc-600 transition dark:border-zinc-800 dark:text-zinc-400;
  }
  .filter-chip[aria-pressed='true'] {
    @apply border-indigo-500 bg-indigo-50 text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-300;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('li[data-type]');
  const years = document.querySelectorAll<HTMLElement>('[data-year-group]');

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((li) => (li.hidden = f !== 'all' && li.dataset.type !== f));
      // Hide years that have no visible entries left.
      years.forEach((y) => (y.hidden = !y.querySelector('li[data-type]:not([hidden])')));
    }),
  );
</script>
