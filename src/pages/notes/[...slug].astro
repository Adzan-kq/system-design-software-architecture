---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { SITE } from '../../config';
import { getTopicGroups, noteHref, readingTime, url } from '../../lib/notes';
import { getJourneyForNote, formatRange } from '../../lib/journey';

export async function getStaticPaths() {
  const groups = await getTopicGroups();
  // Flatten in sidebar order so prev/next follow the roadmap.
  const ordered = groups.flatMap((g) => g.notes.map((note) => ({ note, topic: g.title })));

  return ordered.map(({ note, topic }, i) => ({
    params: { slug: note.id },
    props: { note, topic, prev: ordered[i - 1]?.note, next: ordered[i + 1]?.note },
  }));
}

const { note, topic, prev, next } = Astro.props;
const { Content, headings } = await render(note);
const journeyPhases = await getJourneyForNote(note.id);
const editUrl = `${SITE.repo}/edit/${SITE.branch}/${note.filePath}`;
const { title, description, status, tags, updated } = note.data;
---

<DocsLayout title={title} description={description} headings={headings} currentId={note.id}>
  <article>
    <header class="mb-10">
      <nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 text-sm text-ink-subtle">
        <a href={url('/notes/')} class="transition-colors hover:text-accent">System Design</a>
        <span aria-hidden="true">/</span>
        <span class="text-ink-muted">{topic}</span>
      </nav>

      <h1 class="text-3xl leading-tight font-extrabold text-ink sm:text-[2.6rem]">{title}</h1>
      {description && <p class="mt-4 text-lg leading-relaxed text-ink-muted">{description}</p>}

      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 border-y border-line py-4 text-sm text-ink-subtle">
        <StatusBadge status={status} />
        <span class="inline-flex items-center gap-1.5">
          <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="10" cy="10" r="7.5"></circle><path d="M10 6v4l2.5 2.5"></path>
          </svg>
          {readingTime(note)} min read
        </span>
        {
          updated && (
            <time datetime={updated.toISOString()}>
              Updated {updated.toLocaleDateString('en-US', { dateStyle: 'medium', timeZone: 'UTC' })}
            </time>
          )
        }
        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5 sm:ml-auto" aria-label="Tags">
              {tags.map((t) => (
                <li class="rounded-md bg-subtle px-2 py-0.5 font-mono text-[11px] text-ink-muted">#{t}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="prose prose-lg max-w-none prose-img:rounded-xl">
      <Content />
    </div>

    {
      journeyPhases.length > 0 && (
        <aside class="mt-14 rounded-2xl border border-accent/25 bg-accent-soft p-5">
          <p class="font-mono text-[11px] font-semibold tracking-wider text-accent uppercase">Part of my journey</p>
          <ul class="mt-3 space-y-2">
            {journeyPhases.map((j) => (
              <li class="flex flex-wrap items-baseline gap-x-3">
                <a href={url(`/journey/#j-${j.id}`)} class="font-medium text-ink hover:text-accent">
                  {j.data.title} →
                </a>
                <span class="font-mono text-xs text-ink-subtle">{formatRange(j.data)}</span>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <footer class="mt-14 space-y-6">
      <a
        href={editUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 text-sm text-ink-subtle transition-colors hover:text-accent"
      >
        <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M13.5 3.5a2.1 2.1 0 0 1 3 3L7 16l-4 1 1-4 9.5-9.5Z"></path>
        </svg>
        Edit this page on GitHub
      </a>

      <nav class="grid gap-4 sm:grid-cols-2" aria-label="Pagination">
        {
          prev ? (
            <a
              href={noteHref(prev)}
              class="group rounded-2xl border border-line bg-card p-5 transition hover:border-accent/40 hover:shadow-md"
            >
              <span class="text-xs text-ink-subtle">← Previous</span>
              <span class="mt-1 block font-display font-bold text-ink group-hover:text-accent">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a
              href={noteHref(next)}
              class="group rounded-2xl border border-line bg-card p-5 text-right transition hover:border-accent/40 hover:shadow-md"
            >
              <span class="text-xs text-ink-subtle">Next →</span>
              <span class="mt-1 block font-display font-bold text-ink group-hover:text-accent">{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</DocsLayout>
