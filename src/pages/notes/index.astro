---
/** "System Design" landing page: pillar progress + filterable notes grid. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TopicProgressStrip from '../../components/TopicProgressStrip.astro';
import NotesGrid from '../../components/NotesGrid.astro';
import { getTopicGroups, overallProgress, url } from '../../lib/notes';

const groups = await getTopicGroups();
const pillars = groups.filter((g) => g.notes.length > 0);
const notes = pillars.flatMap((g) => g.notes);
const stats = overallProgress(groups);
---

<BaseLayout title="System Design" description="Study notes and case studies on System Design & Software Architecture.">
  <main class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    <SectionHeading
      as="h1"
      eyebrow="Digital garden"
      title="System Design Notes"
      description={
        stats.total
          ? `${stats.total} notes across ${pillars.length} pillars, ${stats.progress}% of the way through the roadmap.`
          : `${groups.length} pillars on the roadmap. Notes are on their way.`
      }
      link={{ href: url('/roadmap/'), label: 'View roadmap' }}
    />

    <TopicProgressStrip groups={groups} />

    <div class:list={['mt-16 mb-6 flex flex-wrap gap-2', pillars.length < 2 && 'hidden']} role="group" aria-label="Filter by topic">
      <button type="button" data-filter="all" aria-pressed="true" class="chip">All</button>
      {
        pillars.map((g) => (
          <button type="button" data-filter={g.slug} aria-pressed="false" class="chip">
            {g.title}
            <span class="font-mono text-[11px] opacity-60">{g.notes.length}</span>
          </button>
        ))
      }
    </div>

    <div class:list={[pillars.length < 2 && 'mt-16']}>
      <NotesGrid notes={notes} id="notes-grid" />
    </div>
  </main>
</BaseLayout>

<style>
  @reference "../../styles/global.css";
  .chip {
    @apply inline-flex items-center gap-1.5 rounded-full border border-line bg-card px-3.5 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:text-ink;
  }
  .chip[aria-pressed='true'] {
    @apply border-accent/40 bg-accent-soft text-accent;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#notes-grid [data-topic]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((c) => (c.hidden = f !== 'all' && c.dataset.topic !== f));
    }),
  );
</script>
