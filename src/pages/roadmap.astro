---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProgressBar from '../components/ProgressBar.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { STATUS_LABEL, getTopicGroups, noteHref, overallProgress, readingTime, url, type Status } from '../lib/notes';

const groups = await getTopicGroups();
const stats = overallProgress(groups);
const filters: (Status | 'all')[] = ['all', 'completed', 'in-progress', 'planned'];
---

<BaseLayout title="Roadmap" description="Every topic I'm studying and where I am with each one.">
  <main class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
    <SectionHeading
      as="h1"
      eyebrow="Learning roadmap"
      title="Roadmap & Topics"
      description={`${stats.completed} of ${stats.total} notes completed · ${stats.progress}% overall`}
      link={{ href: url('/notes/'), label: 'Browse notes' }}
    />

    <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Filter by status">
      {
        filters.map((f) => (
          <button type="button" data-filter={f} aria-pressed={f === 'all' ? 'true' : 'false'} class="chip">
            {f === 'all' ? 'All' : STATUS_LABEL[f]}
          </button>
        ))
      }
    </div>

    <div class="space-y-5">
      {
        groups.map((g, i) => (
          <section id={g.slug} data-reveal class="rounded-2xl border border-line bg-card p-6">
            <header class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="font-mono text-xs text-ink-subtle">{String(i + 1).padStart(2, '0')}</p>
                <h2 class="mt-1 text-xl font-bold text-ink">{g.title}</h2>
                {g.description && <p class="mt-1 text-sm text-ink-muted">{g.description}</p>}
              </div>
              <StatusBadge status={g.status} />
            </header>

            <div class="mt-5 flex items-center gap-3">
              <ProgressBar value={g.progress} label={`${g.title} progress`} />
              <span class="font-mono text-xs text-ink-subtle">{g.progress}%</span>
            </div>

            {g.notes.length > 0 ? (
              <ul class="mt-5 divide-y divide-line">
                {g.notes.map((n) => (
                  <li data-status={n.data.status}>
                    <a href={noteHref(n)} class="group flex items-center justify-between gap-4 py-3">
                      <span>
                        <span class="font-medium text-ink group-hover:text-accent">{n.data.title}</span>
                        <span class="ml-2 font-mono text-[11px] text-ink-subtle">{readingTime(n)} min</span>
                        {n.data.description && (
                          <span class="mt-0.5 block text-sm text-ink-muted">{n.data.description}</span>
                        )}
                      </span>
                      <StatusBadge status={n.data.status} size="sm" />
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-5 text-sm text-ink-subtle italic">No notes yet. Coming soon.</p>
            )}
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  @reference "../styles/global.css";
  .chip {
    @apply inline-flex items-center gap-1.5 rounded-full border border-line bg-card px-3.5 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:text-ink;
  }
  .chip[aria-pressed='true'] {
    @apply border-accent/40 bg-accent-soft text-accent;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('li[data-status]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((li) => (li.hidden = f !== 'all' && li.dataset.status !== f));
    }),
  );
</script>
